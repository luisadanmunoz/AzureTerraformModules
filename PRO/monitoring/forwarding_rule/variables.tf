#############################################################################
# PRIVATE DNS RESOLVER - FORWADING RULE VARIABLES
#############################################################################
variable "name_forwarding_rule" {
  description = "value of the name forwarding rule tag"
  type        = string
}
variable "dns_forwarding_ruleset" {
  description = "value of the dns forwarding ruleset tag"
  type        = string
}
variable "domain_name" {
  description = "value of the domain name tag"
  type        = string
}
variable "enabled" {
  description = "value of the enabled tag"
  type        = string
}
variable "ip_address" {
  description = "value of the ip address tag"
  type        = string
}
variable "port" {
  description = "value of the port tag"
  type        = string
}
variable "ip_address2" {
  description = "value of the ip address2 tag"
  type        = string
}
variable "port2" {
  description = "value of the port2 tag"
  type        = string
}


